# ======= OpenAI 模式 =======
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini  # 经济稳妥

# ======= 引擎选择（openai 或 local） =======
NS_ENGINE=openai

# ======= 本地模型权重路径（local 模式使用） =======
NS_CKPT=checkpoints/neuroscope/final

# 选择默认引擎：openai 或 local
NS_ENGINE=openai

# 本地模型（只有当你训练并“合并”为完整权重后再填）
# 例如：/Users/你/Desktop/NeuroScope/checkpoints/neuroscope/merged
NS_CKPT=

# （可选）自定义本地对话标签
# NS_ROLE_USER=User
# NS_ROLE_ASSISTANT=Assistant
